@model AcceptedRepairDetailsVM

@{
    ViewData["Title"] = "Szczegóły zlecenia";
}

<h1 class="text-center mb-4">Szczegóły zlecenia</h1>

<div class="container">
    <hr />

    <dl class="row">
        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Id
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Numer rejestracyjny
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>

        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Opis usterki
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @Html.DisplayFor(model => model.EntryIssueDescription)
        </dd>

        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Data zgłoszenia
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @Html.DisplayFor(model => model.SubmissionDate)
        </dd>

        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Status
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @Html.DisplayFor(model => model.StatusDescription)
        </dd>

        <dt class="col-12 col-sm-3 col-md-2 fw-bold">
            Szacunkowy koszt
        </dt>
        <dd class="col-12 col-sm-9 col-md-10">
            @if (Model.EntryEstimatedCost.HasValue)
            {
                @Model.EntryEstimatedCost.Value.ToString("C")
            }
            else
            {
                <span>Niewycenione</span>
            }
        </dd>
    </dl>
    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Home")" class="w3-button w3-small w3-blue w3-round">Powrót</a>
    </div>
</div>
