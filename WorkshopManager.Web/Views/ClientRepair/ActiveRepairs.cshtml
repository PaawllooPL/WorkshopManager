@model ActiveRepairsVM
@using static WorkshopManager.Model.DataModels.RepairOrderStatusValue

<h1 class="text-center mb-4">Aktywne zlecenia</h1>

<div class="container">
    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered text-center">
            <thead class="table-light">
                <tr>
                    <th>Numer rejestracyjny</th>
                    <th>Opis usterki</th>
                    <th>Data zgłoszenia</th>
                    <th>Kwota wyceny</th>
                    <th>Status</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.InProgressOrders.Concat(Model.AcceptedOrders).OrderBy(o => o.StatusDescription == "InProgress" ? 0 : 1))
                {
                    <tr>
                        <td>@order.RegistrationNumber</td>
                        <td>
                            <div class="description-container">
                                @if (order.EntryIssueDescription.Length > 100)
                                {
                                    <span class="short-description">
                                        @(order.EntryIssueDescription.Substring(0, 100) + "...")
                                    </span>
                                    <span class="full-description d-none">
                                        @order.EntryIssueDescription
                                    </span>
                                    <button class="toggle-description btn btn-sm btn-primary mt-2">Rozwiń</button>
                                }
                                else
                                {
                                    <span>@order.EntryIssueDescription</span>
                                }
                            </div>
                        </td>
                        <td>@order.SubmissionDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (order.EntryEstimatedCost.HasValue)
                            {
                                @order.EntryEstimatedCost.Value.ToString("C")
                            }
                            else
                            {
                                <span>Niewycenione</span>
                            }
                        </td>
                        <td>@order.StatusDescription</td>
                        <td>
                            @if (order.Status == Accepted)
                            {
                                <a href="@Url.Action("AcceptedRepairDetails", "ClientRepair", new { id = order.Id })" class="w3-button w3-small w3-blue w3-round">Szczegóły</a>
                            }
                            else if (order.Status == InProgress)
                            {
                                <a href="@Url.Action("InProgressRepairDetails", "ClientRepair", new { id = order.Id })" class="w3-button w3-small w3-blue w3-round">Szczegóły</a>
                            }
                            else
                            {
                                <span>Brak akcji</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Home")" class="w3-button w3-small w3-blue w3-round">Powrót</a>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleButtons = document.querySelectorAll('.toggle-description');

        toggleButtons.forEach(button => {
            button.addEventListener('click', function () {
                const descriptionContainer = button.closest('.description-container');
                const shortDescription = descriptionContainer.querySelector('.short-description');
                const fullDescription = descriptionContainer.querySelector('.full-description');

                if (fullDescription.classList.contains('d-none')) {
                    fullDescription.classList.remove('d-none');
                    shortDescription.classList.add('d-none');
                    button.textContent = 'Zwiń';
                } else {
                    fullDescription.classList.add('d-none');
                    shortDescription.classList.remove('d-none');
                    button.textContent = 'Rozwiń';
                }
            });
        });
    });
</script>

<style>
    .description-container {
        max-width: 100%;
    }

    .short-description {
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .full-description {
        display: inline-block;
    }
</style>
