@model InProgressRepairDetailsVM

@{
    ViewData["Title"] = "Szczegóły zlecenia";
}

<h1>Szczegóły zlecenia</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">Numer rejestracyjny</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RegistrationNumber)</dd>

        <dt class="col-sm-2">Opis usterki</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EntryIssueDescription)</dd>

        <dt class="col-sm-2">Data zgłoszenia</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SubmissionDate)</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusDescription)</dd>

        <dt class="col-sm-2">Szacunkowy koszt</dt>
        <dd class="col-sm-10">
            @if (Model.EntryEstimatedCost.HasValue)
            {
                @Model.EntryEstimatedCost.Value.ToString("C")
            }
            else
            {
                <span>Niewycenione</span>
            }
        </dd>
        <dt class="col-sm-2">Obecny koszt</dt>
        <dd class="col-sm-10">
            <span>@(Model.RepairTasks.Aggregate(0m, (cost, rt) => rt.IsCompleted ? cost + rt.Cost : cost) + " zł")</span>
         </dd>
    </dl>

    <h3>Czynności Naprawcze</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th class="w-50">Opis</th>
                <th>Szacowany koszt</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model.RepairTasks)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>
                        <div class="description-container">
                            @if (task.Description.Length > 100)
                            {
                                    <span class="short-description">
                                        @(task.Description.Substring(0, 100) + "...")
                                    </span>
                                    <span class="full-description" style="display:none;">
                                        @task.Description
                                    </span>
                                    <button class="toggle-description w3-button w3-small w3-blue w3-round" type="button">Rozwiń</button>
                            }
                            else
                            {
                                    <span>@task.Description</span>
                            }
                        </div>
                    </td>
                    <td>@task.Cost.ToString("C")</td>
                    <td>
                        @if (task.AcceptedByCustomer.HasValue)
                        {
                            @((task.AcceptedByCustomer.Value) ? task.IsCompleted ? "Zakończone" : "Zaakceptowane" : "Odrzucone")
                        }
                        else
                        {
                            <span>Oczekujące</span>
                        }
                    </td>
                    
                    @if(@task.AcceptedByCustomer == null) 
                    {
                        <td>
                            <div class="d-flex">
                                <form asp-controller="RepairTask" asp-action="AcceptTask" asp-route-id="@task.Id" method="post" style="margin-right: 5px;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w3-button w3-green w3-round">Akceptuj</button>
                                </form>

                                <form asp-controller="RepairTask" asp-action="RejectTask" asp-route-id="@task.Id" method="post">
                                        @Html.AntiForgeryToken()
                                    <button type="submit" class="w3-button w3-red w3-round">Odrzuć</button>
                                </form>
                            </div>
                        </td>

                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleButtons = document.querySelectorAll('.toggle-description');

        toggleButtons.forEach(button => {
            button.addEventListener('click', function () {
                const descriptionContainer = button.closest('.description-container');
                const shortDescription = descriptionContainer.querySelector('.short-description');
                const fullDescription = descriptionContainer.querySelector('.full-description');

                if (fullDescription.style.display === 'none') {
                    fullDescription.style.display = 'inline';
                    shortDescription.style.display = 'none';
                    button.textContent = 'Zwiń';
                } else {
                    fullDescription.style.display = 'none';
                    shortDescription.style.display = 'inline';
                    button.textContent = 'Rozwiń';
                }
            });
        });
    });
</script>

<style>
    .description-container {
        max-width: 100%;
    }
    .short-description {
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .full-description {
        display: none;
    }
</style>