@model UpdateContactInfoVM

<h1 class="text-center">Edycja danych kontaktowych</h1>

<form asp-action="UpdateContactInfo" method="post" class="form-horizontal">
    @Html.AntiForgeryToken()

    <!-- Wyświetlanie komunikatów o błędach -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label class="control-label col-md-2">Imię:</label>
        <div class="col-md-10">
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Nazwisko:</label>
        <div class="col-md-10">
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Numer telefonu:</label>
        <div class="col-md-10">
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group text-center">
        <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    </div>
</form>

@section Scripts {
    @* Włącz walidację klienta *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<a class="w3-bar-item w3-button w3-green w3-large w3-round w3-padding w3-hover-opacity w3-hover-shadow"
   asp-controller="ClientRepair" asp-action="Index">
    Powrot
</a>
