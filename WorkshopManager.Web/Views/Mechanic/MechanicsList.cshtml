 @model IEnumerable<WorkshopManager.ViewModels.VM.MechanicVM>

@{
    ViewData["Title"] = "Lista Mechaników";
}
<h2 style="text-align: center">Lista Mechaników</h2>

<a class="w3-bar-item w3-button w3-blue w3-large w3-round w3-padding w3-hover-opacity w3-hover-shadow"
   asp-controller="Mechanic" asp-action="AddMechanic">
    Dodaj Nowego Mechanika
</a>
<br>
<br>
<br>


<div class="w3-container">
    <table class="w3-table-all w3-centered w3-hoverable w3-striped w3-card-4" style="width: 100%; table-layout: fixed;">
        <thead>
            <tr class="w3-light-grey">
                <th>Imię</th>
                <th>Nazwisko</th>
                <th>Numer konta bankowego</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mechanic in Model)
            {
                <tr>
                    <td>@mechanic.FirstName</td>
                    <td>@mechanic.LastName</td>
                    <td>@mechanic.BankAccountNumber</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<style>
    .w3-container {
        max-height: 80vh;
        overflow-y: auto;
        margin-bottom: 20px;
        width: 100%;
    }

    .w3-table-all {
        width: 100%;
        table-layout: fixed;
    }

    .description-container {
        max-width: 100%;
    }

    .short-description {
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .toggle-description {
        margin-top: 5px;
        padding: 0 5px;
    }
</style>





























