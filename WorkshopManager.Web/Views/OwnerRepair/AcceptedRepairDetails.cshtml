@model WorkshopManager.ViewModels.VM.AcceptedRepairDetailsVM

@{
    ViewData["Title"] = "AcceptedRepairDetails";
}

<h1>Szczegóły zlecenia</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-12 col-sm-2">
            Id
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-12 col-sm-2">
            Numer rejestracyjny
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>
        <dt class="col-12 col-sm-2">
            Opis usterki
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.EntryIssueDescription)
        </dd>
        <dt class="col-12 col-sm-2">
            Data zgłoszenia
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.SubmissionDate)
        </dd>
        <dt class="col-12 col-sm-2">
            Status
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.StatusDescription)
        </dd>
        <dt class="col-12 col-sm-2">
            Szacunkowy koszt
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.EntryEstimatedCost)
        </dd>
        <dt class="col-12 col-sm-10">
            Akcje
        </dt>
        <dd class="col-12 col-sm-10">
            <div style="display: flex; flex-direction: column;" class="mt-3">
                <a href="@Url.Action("StartRepair", "OwnerRepair", new{id = Model.Id})" class="w3-button w3-small w3-blue w3-round col-10 col-md-4 col-lg-2">Rozpocznij naprawę</a>
            </div>
        </dd>
    </dl>
</div>
