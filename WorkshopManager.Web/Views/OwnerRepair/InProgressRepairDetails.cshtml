@model WorkshopManager.ViewModels.VM.InProgressRepairDetailsVM

@{
    ViewData["Title"] = "InProgressRepairDetails";
}

<h1>Szczegóły zlecenia</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-12 col-sm-2">
            Id
        </dt>
        <dd class = "col-12 col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-12 col-sm-2">
            Numer rejestracyjny
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>
        <dt class="col-12 col-sm-2">
            Opis usterki
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.EntryIssueDescription)
        </dd>
        <dt class="col-12 col-sm-2">
            Data zgłoszenia
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.SubmissionDate)
        </dd>
        <dt class="col-12 col-sm-2">
            Status
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.StatusDescription)
        </dd>
        <dt class="col-12 col-sm-2">
            Szacunkowy koszt
        </dt>
        <dd class="col-12 col-sm-10">
            @Html.DisplayFor(model => model.EntryEstimatedCost)
        </dd>
        <dt class="col-12 col-sm-10">
            Akcje
        </dt>
        <dd class="col-12 col-sm-10">
            <div style="display: flex; flex-direction: row">
                <a href="@Url.Action("Add", "RepairTask", new{id = Model.Id})" class="w3-button w3-small w3-blue w3-round col-10 col-md-4 col-lg-2">Dodaj czynność naprawczą</a>
            </div>
        </dd>
    </dl>
</div>

<h2>Czynności naprawcze</h2>

<table class="w3-table-all w3-centered w3-hoverable w3-striped w3-card-4" style="width: 100%; table-layout: fixed;">
    <thead>
        <tr class="w3-light-grey">
            <th>Szacowany koszt</th>
            <th>Opis</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model.RepairTasks ?? new List<RepairTaskVM>())
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => task.Cost)</td>
                <td>@Html.DisplayFor(modelItem => task.Description)</td>
                <td>
                    @if (task.AcceptedByCustomer.HasValue)
                    {
                        if (task.AcceptedByCustomer.Value)
                        {
                            <span>Zaakceptowane</span>
                        }
                        else
                        {
                            <span>Niezaakceptowane</span>
                        }
                    }
                    else
                    {
                        <span>Nieznane</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

