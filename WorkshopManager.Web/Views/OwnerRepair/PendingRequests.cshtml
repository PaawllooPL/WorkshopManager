@model IEnumerable<WorkshopManager.ViewModels.VM.PendingEstimateVM>

@{
    ViewData["Title"] = "PendingRequests";
}

<h1>PendingRequests</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SubmissionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model ?? Enumerable.Empty<PendingEstimateVM>()) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SubmissionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                
            
               
            </td>
        </tr>
}
    </tbody>
</table>
