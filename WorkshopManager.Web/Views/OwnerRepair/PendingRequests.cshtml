@model WorkshopManager.ViewModels.VM.PendingRequestsVM

@{
	ViewData["Title"] = "PendingRequests";
}

<h2>Zlecenia bez wyceny</h2>

<table class="w3-table-all w3-centered w3-hoverable w3-striped w3-card-4" style="width: 100%; table-layout: fixed;">
	<thead>
		<tr>
			<th>
				Data zgłoszenia
			</th>
			<th>
				Status
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.PendingEstimates ?? Enumerable.Empty<PendingEstimateVM>())
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.SubmissionDate)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.StatusDescription)
				</td>
				<td>
					<a class="w3-bar-item w3-button w3-blue w3-small w3-round w3-padding w3-hover-opacity w3-hover-shadow"
					   asp-controller="OwnerRepair" asp-action="RespondToRequest" asp-route-id="@item.Id">
						Szczegóły
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<br />

<h2>Zlecenia wycenione</h2>
<table class="w3-table-all w3-centered w3-hoverable w3-striped w3-card-4" style="width: 100%; table-layout: fixed;">
	<thead>
		<tr>
			<th>
				Data zgłoszenia
			</th>
			<th>
				Status
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.ClientApprovals ?? Enumerable.Empty<ClientApprovalVM>())
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.SubmissionDate)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.StatusDescription)
				</td>
				<td>
					<a class="w3-bar-item w3-button w3-blue w3-small w3-round w3-padding w3-hover-opacity w3-hover-shadow"
					   asp-controller="OwnerRepair" asp-action="RespondToRequest" asp-route-id="@item.Id">
						Szczegóły
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>