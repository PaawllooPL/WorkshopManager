@model WorkshopManager.ViewModels.VM.PendingEstimateVM

@{
    ViewData["Title"] = "RespondToRequest";
}

<h1>RespondToRequest</h1>
<form asp-controller="OwnerRepair" asp-action="RespondToRequest" method="post">
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.RegistrationNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.RegistrationNumber)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.EntryIssueDescription)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.EntryIssueDescription)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.SubmissionDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.SubmissionDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Status)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.EntryEstimatedCost)
            </dt>
            <dd class="col-sm-10 d-flex align-items-center">
                <input type="number" step="0.01" class="form-control w-auto" asp-for="EntryEstimatedCost" min="0" />
            </dd>
        </dl>
    </div>

    <div class="mt-3 d-flex gap-2">
        <form asp-controller="OwnerRepair" asp-action="RespondToRequest" method="post" class="mb-0">
            <input type="hidden" name="Id" value="@Model.Id" />
            <!-- Wysłanie wyceny do klienta -->
            <button type="submit" class="btn btn-success">
                Wyślij wycenę do klienta
            </button>
        </form>

        <!-- Odrzucenie zlecenia -->
        <a class="btn btn-danger" asp-controller="OwnerRepair" asp-action="RejectRequest" method="post" asp-route-id="@Model.Id">
                Odrzuć zlecenie
        </a>
    </div>
</form>
