@model WorkshopManager.ViewModels.VM.PendingEstimateVM

@{
	ViewData["Title"] = "RespondToRequest";
}

<h1>Odpowiedź na zgłoszenie</h1>
<form asp-controller="OwnerRepair" asp-action="RespondToRequest" method="post">
	<div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">
				Id
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Id)
			</dd>
			<dt class="col-sm-2">
				Numer rejestracyjny
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.RegistrationNumber)
			</dd>
			<dt class="col-sm-2">
				Opis usterki
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.EntryIssueDescription)
			</dd>
			<dt class="col-sm-2">
				Data zgłoszenia
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.SubmissionDate)
			</dd>
			<dt class="col-sm-2">
				Status
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.StatusDescription)
			</dd>
			<dt class="col-sm-2">
				Szacunkowy koszt
			</dt>
			<dd class="col-sm-10 d-flex align-items-center">
				<input type="number" step="0.01" class="form-control w-auto" asp-for="EntryEstimatedCost" min="0" />
			</dd>
		</dl>
	</div>

	<div class="mt-3 d-flex gap-2">
		<!-- Wysłanie wyceny do klienta -->
		<button type="submit" class="w3-bar-item w3-button w3-green w3-large w3-round w3-padding w3-hover-opacity w3-hover-shadow">
			Wyślij wycenę do klienta
		</button>
	</div>
</form>

<!-- Odrzucenia zlecenia -->
<form asp-controller="OwnerRepair" asp-action="RejectRequest" method="post" class="mt-3">
	<input type="hidden" name="Id" value="@Model.Id" />
	<button type="submit" class="w3-bar-item w3-button w3-red w3-large w3-round w3-padding w3-hover-opacity w3-hover-shadow">
		Odrzuć zlecenie
	</button>
</form>
